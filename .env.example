INFLUXDB_PORT=8181
INFLUXDB_HOST=influxdb3-core
INFLUXDB_TOKEN=
# Preserved once supplied or automatically bootstrapped; never regenerated.
INFLUXDB_BUCKET=local_system
INFLUXDB_ORG=itp
INFLUXDB_NODE_ID=
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
TELEGRAF_COLLECTION_INTERVAL=60s
TZ=UTC
ITP_DEPLOYMENT_ID=
DOCKER_SOCKET=
ITP_RUNTIME_MODE=central
# Active site registry. Copy config/sites.yml to config/sites.local.yml for
# deployment-specific names, then change this path in the ignored .env.
ITP_SITES_CONFIG=./config/sites.yml
# Optional ignored non-secret connector override.
ITP_CONNECTORS_CONFIG=./config/connectors.local.example.yml
# Optional generic notification webhook values. Leave empty when disabled.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_AUTHORIZATION=
