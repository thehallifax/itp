#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BOOTSTRAP="$ROOT_DIR/scripts/bootstrap.py"

if [ ! -f "$BOOTSTRAP" ]; then
    echo "ITP bootstrap error: missing scripts/bootstrap.py. Restore the repository and rerun ./itp." >&2
    exit 1
fi

is_supported_python() {
    "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
        >/dev/null 2>&1
}

PYTHON=""
PYTHON_LABEL=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && is_supported_python "$candidate"; then
        PYTHON=$(command -v "$candidate")
        PYTHON_LABEL=$candidate
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "ITP bootstrap error: Python 3.9 or later was not found." >&2
    echo "Install a supported Python release, then rerun ./itp." >&2
    exit 1
fi

ITP_BOOTSTRAP_PYTHON_LABEL=$PYTHON_LABEL
ITP_BOOTSTRAP_PYTHON_VERSION=$(
    "$PYTHON" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")'
)
if [ -f "$ROOT_DIR/.venv/.itp-dependencies.json" ]; then
    ITP_BOOTSTRAP_SHOW_PROGRESS=0
else
    ITP_BOOTSTRAP_SHOW_PROGRESS=1
fi
export ITP_BOOTSTRAP_PYTHON_LABEL
export ITP_BOOTSTRAP_PYTHON_VERSION
export ITP_BOOTSTRAP_SHOW_PROGRESS

exec "$PYTHON" "$BOOTSTRAP" "$@"
